# ==============================================================================
# Volume Stabilizer ユーザー設定ファイル
# ==============================================================================
# このファイルをコピーして `.env` を作成し、必要に応じて値を変更してください。
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ディレクトリ設定 (ホスト側のパス)
# ------------------------------------------------------------------------------
# 処理対象の元音源が入っているフォルダ (安全のためコンテナ内からは読み取り専用)
# 例: ./music, /volume1/music (NAS), /mnt/nas/music (Linux), D:/DJ_Music (Windows)
MUSIC_DIR=./music

# 音量を統一した音源ファイルの出力先フォルダ
# 例: ./output, /volume1/music_stabilized (NAS), /mnt/nas/dj_output
OUTPUT_DIR=./output

# データベース (SQLite) やキャッシュ、バックアップ情報の保存先
# ※高速なローカルSSD上のパスを推奨します (NASのSMB共有上は非推奨)
DATA_DIR=./data

# ------------------------------------------------------------------------------
# 2. ネットワーク / Web UI 設定
# ------------------------------------------------------------------------------
# ブラウザからアクセスするポート番号 (http://localhost:PORT)
PORT=8080

# ------------------------------------------------------------------------------
# 3. 音響 / ラウドネス設定 (DJ向け推奨値)
# ------------------------------------------------------------------------------
# 目標ラウドネス値 (EBU R128 Integrated LUFS)
# デフォルト: -10.0 (rekordbox Auto Gain水準、クラブ音源のダイナミクスを保持)
VS_TARGET_LUFS=-10.0

# トゥルーピーク上限 (dBTP)
# デフォルト: -1.0 (DACでのインターサンプルピーク歪みや圧縮時の音割れを防止)
VS_PEAK_CEILING=-1.0

# リミッターの最大ゲインリダクション上限 (dB)
# デフォルト: 3.0 (極端に音量の小さい曲でキックのアタックが潰れるのを防ぐため、リミッターを最大3dBで頭打ちにします)
VS_MAX_REDUCTION=3.0

# MP3無加工バイパスの許容誤差 (LU)
# デフォルト: 0.5 (目標値±この値の範囲内にありピーク基準も満たすMP3は、再エンコードせず無劣化ストリームコピー)
VS_BYPASS_TOLERANCE=0.5

# ------------------------------------------------------------------------------
# 4. パフォーマンス / システム設定
# ------------------------------------------------------------------------------
# 同時並列処理ワーカー数
# デフォルト: 0 (自動: CPUコア数 - 1)
# NAS等の他サービスと同居させる場合やCPU使用率を抑えたい場合は 1 や 2 を指定
VS_WORKERS=0
